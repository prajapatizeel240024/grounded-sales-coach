# Copy to .env and fill in. FieldCoach reads .env on startup and never overrides
# variables that are already set in your shell.

# Needed for the Claude backend. Without it, everything runs on the offline keyword baseline.
ANTHROPIC_API_KEY=

# Model used for analysis and coaching notes.
FIELDCOACH_MODEL=claude-sonnet-5-5

# Optional: low | medium | high. Leave empty to use the model's default effort.
FIELDCOACH_EFFORT=

# Parallel Claude requests during an eval run.
FIELDCOACH_CONCURRENCY=4

# Postgres. Leave it commented out to serve from the tracked files. Uncomment it once
# `docker compose up` is running if you want local CLI runs recorded in that database.
# DATABASE_URL=postgresql://fieldcoach:fieldcoach@localhost:5433/fieldcoach
